classDiagram
    class Venda {
        +int id
        +Date data
        +double total
        +finalizar()
        +calcularTotal()
    }

    class ItemVenda {
        +int quantidade
        +double preco
        +calcularSubtotal()
    }

    class Produto {
        +int id
        +String nome
        +double preco
        +int estoque
        +atualizarEstoque()
    }

    class Pagamento {
        +int id
        +double valor
        +String forma
        +processar()
    }

    class Operador {
        +int id
        +String nome
        +registrarVenda()
    }

    Venda "1" --> "*" ItemVenda
    ItemVenda "*" --> "1" Produto
    Venda "1" --> "1" Pagamento
    Operador "1" --> "*" Venda