classDiagram
    class Emprestimo {
        - id
        - livro
        - iser
        - dueDate
        - retriveDate
        - loanDate
        + emprestar(user, livro, dueDate, retriveDate, loanDate)
        + renovar(newDueDate)
        + devolução()
        + isOverDue()
    }

    class Notification {
        <<interface>>
        + notify(emprestimo)
    }

    class EmailNotificador {
        + notify(emprestimo)
    }

    Emprestimo --> Notification : usa
    EmailNotificador ..|> Notification : implementação


